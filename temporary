zip_by_date() {
    # Check if a date argument was provided (Format: YYYYMMDD)
    if [ -z "$1" ] || [ ${#1} -ne 8 ]; then
        echo "Error: Please provide a date in YYYYMMDD format (e.g., 20260925)."
        return 1
    fi

    input_date="$1"
    suffix="$2" 
    
    # Reformat YYYYMMDD to YYYY-MM-DD for the touch command
    target_date="${input_date:0:4}-${input_date:4:2}-${input_date:6:2}"
    
    dir="/storage/emulated/10/DCIM/Camera"
    output_zip="${dir}/${input_date}${suffix}.zip"

    # Move to the target directory
    cd "$dir" || { echo "Error: Directory not found."; return 1; }

    echo "Processing files for date: ${target_date}..."

    # Create temporary boundary files inside the Camera directory to avoid permission issues
    touch -d "${target_date} 00:00:00" .start_time
    touch -d "${target_date} 23:59:59" .end_time

    # Initialize an empty string variable to hold file arguments
    file_args=""

    # Find regular files within the specified date boundary
    for f in *; do
        # Ignore hidden files, directories, hashes, and zip files
        if [ "${f#############.}" != "$f" ] && [ -f "$f" ] && [ "${f##*.}" != "sha256" ] && [ "${f##*.}" != "zip" ]; then
            # Check if file timestamp falls within boundaries
            if [ "$f" -nt .start_time ] && [ ! "$f" -nt .end_time ]; then
                
                # Determine hash tool (ADB shell typically uses sha256sum)
                if command -v sha256sum >/dev/null 2>&1; then
                    sha256sum "$f" > "$f.sha256"
                else
                    shasum -a 256 "$f" > "$f.sha256"
                fi
                
                # Match the timestamp of the hash file to the master file
                touch -r "$f" "$f.sha256"

                # Append both files to our execution string safely
                file_args="$file_args \"$f\" \"$f.sha256\""
            fi
        fi
    done

    # Clean up temporary boundary files immediately
    rm -f .start_time .end_time

    # Check if we actually found any files
    if [ -z "$file_args" ]; then
        echo "No files found matching the date ${input_date}."
        return 0
    fi

    # Zip the files using eval to properly parse the string variables in basic toybox sh
    echo "Creating archive with zero compression..."
    eval "zip -0 \"$output_zip\" $file_args"

    # Update the ZIP file's timestamp to 23:59:59 of the input date
    touch -d "${target_date} 23:59:59" "$output_zip"

    echo "Success! Created archive: ${output_zip}"
}
zip_by_date() {
    if [ -z "$1" ] || [ ${#1} -ne 8 ]; then
        echo "Error: Please provide a date in YYYYMMDD format (e.g., 20260925)."
        return 1
    fi

    input_date="$1"
    suffix="$2" 
    target_date="${input_date:0:4}-${input_date:4:2}-${input_date:6:2}"
    
    # Auto-detect correct storage path (0 is primary user, 10 is secondary profile)
    if [ -d "/storage/emulated/0/DCIM/Camera" ]; then
        dir="/storage/emulated/0/DCIM/Camera"
    elif [ -d "/storage/emulated/10/DCIM/Camera" ]; then
        dir="/storage/emulated/10/DCIM/Camera"
    elif [ -d "/sdcard/DCIM/Camera" ]; then
        dir="/sdcard/DCIM/Camera"
    else
        echo "Error: Camera directory not found anywhere."
        return 1
    fi

    output_zip="${dir}/${input_date}${suffix}.zip"

    cd "$dir" || { echo "Error: Cannot change directory to $dir"; return 1; }

    echo "Processing files in: $dir for date: ${target_date}..."

    touch -d "${target_date} 00:00:00" .start_time
    touch -d "${target_date} 23:59:59" .end_time

    file_args=""

    for f in *; do
        if [ -f "$f" ] && [ "${f##*.}" != "sha256" ] && [ "${f##*.}" != "zip" ]; then
            if [ "$f" -nt .start_time ] && [ ! "$f" -nt .end_time ]; then
                if command -v sha256sum >/dev/null 2>&1; then
                    sha256sum "$f" > "$f.sha256"
                else
                    shasum -a 256 "$f" > "$f.sha256"
                fi
                touch -r "$f" "$f.sha256"
                file_args="$file_args \"$f\" \"$f.sha256\""
            fi
        fi
    done

    rm -f .start_time .end_time

    if [ -z "$file_args" ]; then
        echo "No files found matching the date ${input_date}."
        return 0
    fi

    echo "Creating archive with zero compression..."
    eval "zip -0 \"$output_zip\" $file_args"

    touch -d "${target_date} 23:59:59" "$output_zip"
    echo "Success! Created archive: $output_zip"
}
